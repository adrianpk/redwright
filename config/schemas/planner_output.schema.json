{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "message",
    "actions",
    "gaps",
    "control_intent",
    "control_scope",
    "operational_intent",
    "operational_scope",
    "operational_args",
    "operational_requires_project",
    "operational_requires_confirmation",
    "skill_requested",
    "skill_mode",
    "skill_actions",
    "skill_exit_condition"
  ],
  "properties": {
    "intent": { "type": "string", "enum": ["change", "meta"] },
    "message": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "control_intent": {
      "type": "string",
      "enum": ["none", "proceed_with_current_context", "cancel_clarification_only", "cancel_task", "cancel_all"]
    },
    "control_scope": {
      "type": "string",
      "enum": ["none", "gap", "task", "workstream", "chat", "runtime"]
    },
    "operational_intent": {
      "type": "string",
      "enum": [
        "none",
        "project_new",
        "project_switch",
        "project_list",
        "project_where",
        "repo_clone",
        "repo_status",
        "repo_undo",
        "task_pause",
        "task_resume",
        "task_cancel",
        "plan_start",
        "plan_continue",
        "plan_stop_and_apply",
        "trace_on",
        "trace_off",
        "trace_status",
        "help"
      ]
    },
    "operational_scope": {
      "type": "string",
      "enum": ["none", "session", "project", "runtime"]
    },
    "operational_args": { "type": "object" },
    "operational_requires_project": { "type": "boolean" },
    "operational_requires_confirmation": { "type": "boolean" },
    "skill_requested": { "type": "string" },
    "skill_mode": { "type": "string", "enum": ["none", "explicit", "inferred"] },
    "skill_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill_action" }
    },
    "skill_exit_condition": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operational_intent": { "type": "string", "not": { "const": "none" } } },
        "required": ["operational_intent"]
      },
      "then": {
        "properties": {
          "operational_scope": { "type": "string", "not": { "const": "none" } },
          "control_intent": { "const": "none" }
        }
      }
    },
    {
      "if": {
        "properties": { "control_intent": { "type": "string", "not": { "const": "none" } } },
        "required": ["control_intent"]
      },
      "then": {
        "properties": {
          "operational_intent": { "const": "none" }
        }
      }
    },
    {
      "if": {
        "properties": { "operational_requires_project": { "const": true } },
        "required": ["operational_requires_project"]
      },
      "then": {
        "properties": {
          "operational_args": {
            "type": "object",
            "required": ["project_ref"],
            "properties": {
              "project_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "args", "requires_confirmation", "timeout_ms", "on_failure"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "list_files", "read_file", "search", "write_file", "apply_patch", "run", "git_status", "git_branch", "git_commit", "git_push", "git_undo",
            "write_files", "run_command", "run_commands"
          ]
        },
        "args": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "files": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              },
              "required": ["files"]
            },
            {
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "content"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "content": { "type": "string" }
                    }
                  }
                }
              },
              "required": ["files"]
            },
            { "type": "object" }
          ]
        },
        "requires_confirmation": { "type": "boolean" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "on_failure": { "type": "string", "enum": ["abort", "continue"] }
      }
    },
    "skill_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "args", "requires_confirmation", "timeout_ms", "on_failure"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "args": { "type": "object" },
        "requires_confirmation": { "type": "boolean" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "on_failure": { "type": "string", "enum": ["abort", "continue"] }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "field", "inferred_value", "resolved", "priority"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "inferred_value": { "type": "string" },
        "resolved": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  }
}
