<article class="ticket-card" id="<%= dom_id(ticket) %>" draggable="true" data-ticket-id="<%= ticket.id %>" data-edit-url="<%= edit_ticket_path(ticket) %>">
  <header>
    <h3><%= ticket.title %></h3>
    <span class="priority <%= ticket.priority %>"><%= ticket.priority %></span>
  </header>
  <% if ticket.description.present? %>
    <p><%= ticket.description %></p>
  <% end %>
  <div class="ticket-times">
    <span>Total: <%= seconds_to_readable(ticket.total_elapsed_seconds) %></span>
    <span>Review: <%= seconds_to_readable(ticket.review_elapsed_seconds) %></span>
  </div>
  <footer>
    <% ticket.labels.each do |label| %>
      <span class="ticket-label" style="background-color: <%= label.color %>"><%= label.name %></span>
    <% end %>
  </footer>
  <% if ticket.assignee.present? %>
    <div class="ticket-assignee">@<%= ticket.assignee %></div>
  <% end %>
</article>
