<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <section class="modal-card ticket-editor">
      <header class="modal-header">
        <h1>New Ticket</h1>
        <button type="button" class="ticket-action modal-close">Close</button>
      </header>
      <%= render "form", ticket: @ticket, url: board_tickets_path(@board), submit_label: "Create ticket" %>
    </section>
  </div>
<% end %>
