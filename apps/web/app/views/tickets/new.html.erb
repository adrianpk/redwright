<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <section class="modal-card ticket-editor">
      <header class="modal-header">
        <h1>New Ticket</h1>
        <button type="button" class="modal-close-icon modal-close" aria-label="Close modal">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </header>
      <%= render "form", ticket: @ticket, url: board_tickets_path(@board), submit_label: "Create ticket" %>
    </section>
  </div>
<% end %>
