<%= form_with model: artifact, html: { class: "document-artifact-form" } do |f| %>
  <% if artifact.errors.any? %>
    <div class="document-artifact-errors">
      <h2><%= pluralize(artifact.errors.count, "error") %> blocked this draft:</h2>
      <ul>
        <% artifact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="document-artifact-field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>
  <div class="document-artifact-field">
    <%= f.label :body %>
    <%= f.text_area :body, rows: 14, required: true %>
  </div>
  <div class="document-artifact-actions">
    <%= f.submit class: "ticket-action" %>
  </div>
<% end %>
