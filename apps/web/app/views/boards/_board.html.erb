<section class="board-shell">
  <header class="board-header">
    <div class="board-title-row">
      <h1><%= @board.name %></h1>
      <%= link_to "New ticket", new_board_ticket_path(@board), class: "ticket-action", data: { turbo_frame: "modal" } %>
    </div>
  </header>

  <div class="board-columns" data-board-id="<%= @board.id %>">
    <% @columns.each do |column| %>
      <%= render "boards/column", column: column %>
    <% end %>
  </div>

  <div class="drag-drop-zones" id="drag-drop-zones" aria-hidden="true">
    <div class="drop-zone zone-archive" data-drop-action="archive">
      <div class="drop-zone-glyph">
        <svg class="drop-zone-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 7h18" />
          <path d="M5 7v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7" />
          <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
          <path d="M10 11v5M14 11v5" />
        </svg>
      </div>
    </div>
    <div class="drop-zone zone-delete" data-drop-action="delete">
      <div class="drop-zone-glyph">
        <svg class="drop-zone-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
          <path d="M7 7l1 12a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-12" />
          <path d="M10 11v6M14 11v6" />
        </svg>
      </div>
    </div>
  </div>
</section>
