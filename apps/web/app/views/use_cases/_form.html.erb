<% form_html_options = {} %>
<% form_html_options[:id] = local_assigns[:form_id] if local_assigns[:form_id].present? %>

<%= form_with model: use_case, url: url, html: form_html_options do |f| %>
  <%= f.hidden_field :corrects_use_case_id, value: use_case.corrects_use_case_id || params[:corrects_use_case_id] %>
  <% if use_case.errors.any? %>
    <div class="form-errors">
      <% use_case.errors.each do |error| %>
        <% next if error.attribute == :slug %>
        <p><%= error.full_message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 8, required: true %>
  </div>

  <% unless local_assigns[:render_actions] == false %>
    <div class="form-actions">
      <%= f.submit submit_label, class: "ticket-action" %>
    </div>
  <% end %>
<% end %>
