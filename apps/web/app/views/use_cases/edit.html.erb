<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <section class="modal-card use-case-editor">
      <header class="modal-header">
        <h1>Edit Use Case</h1>
        <div class="modal-header-actions">
          <button type="button" class="modal-icon-button modal-close" aria-label="Close modal">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </header>
      <%= render "form", use_case: @use_case, url: project_use_case_path(@project, params[:slug]), submit_label: "Save changes" %>
    </section>
  </div>
<% end %>
