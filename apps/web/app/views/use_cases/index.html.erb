<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row">
      <h1>Use Cases</h1>
      <%= link_to "New Use Case", new_project_use_case_path(@project), class: "ticket-action", data: { turbo_frame: "modal" } %>
    </div>
  </section>

  <%= turbo_frame_tag "modal" %>

  <section class="use-cases-index-table-shell" aria-label="Use cases">
    <table class="use-cases-index-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Slug</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @use_cases.each do |use_case| %>
          <tr>
            <td><%= use_case.name %></td>
            <td><%= use_case.description %></td>
            <td><%= use_case.slug %></td>
            <td><%= link_to "Edit", edit_project_use_case_path(@project, use_case), class: "ticket-action", data: { turbo_frame: "modal" } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>
