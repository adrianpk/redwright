<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row catalog-actions">
      <h1 class="visually-hidden">Specs</h1>
      <%= link_to "New", new_document_path(project_id: @project.id), class: "ticket-action", data: {turbo_frame: "modal"} %>
    </div>
  </section>
  <%= turbo_frame_tag "modal" %>
  <section class="artifact-type-nav" aria-label="Specification navigation">
    <% @artifacts.each do |artifact| %>
      <%= link_to document_path(artifact), class: "artifact-type-card" do %>
        <h2><%= artifact.title %></h2>
        <p><%= artifact.status.humanize %><% if artifact.use_case %> · <%= artifact.use_case.name %><% end %></p>
      <% end %>
    <% end %>
    <% if @artifacts.empty? %><p>No specs yet.</p><% end %>
  </section>
</main>
