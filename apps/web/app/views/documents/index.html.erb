<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row">
      <h1>Documents</h1>
      <%= link_to "New Draft", new_document_path, class: "ticket-action" %>
    </div>
    <section class="artifact-type-nav" aria-label="Document type navigation">
      <% @document_type_cards.each do |card| %>
        <%= link_to documents_navigation_path(type: card.fetch(:type)), class: "artifact-type-card#{' is-active' if @selected_type == card.fetch(:type)}" do %>
          <h2><%= card.fetch(:title) %></h2>
          <% if card.fetch(:preview_lines).any? %>
            <div class="protocol-card-preview" aria-hidden="true">
              <% card.fetch(:preview_lines).each do |line| %>
                <span><%= line %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </section>
  </section>
  <section class="artifact-type-nav" aria-label="Document navigation">
    <% @artifacts.each do |artifact| %>
      <%= link_to document_path(artifact), class: "artifact-type-card" do %>
        <h2><%= artifact.title %></h2>
        <% preview_lines = artifact.body.to_s.lines.map(&:strip).reject(&:blank?).first(6) %>
        <% if preview_lines.any? %>
          <div class="protocol-card-preview" aria-hidden="true">
            <% preview_lines.each do |line| %>
              <span><%= line %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>
</main>
