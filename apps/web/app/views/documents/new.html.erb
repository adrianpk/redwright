<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <section class="modal-card specification-editor" role="dialog" aria-modal="true" aria-labelledby="new-spec-heading">
      <header class="modal-header">
        <h1 id="new-spec-heading">New</h1>
        <button type="button" class="modal-icon-button modal-close" aria-label="Close modal">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>
      <nav class="specification-authoring-modes" aria-label="Creation method">
        <%= link_to "Generate", new_document_path(project_id: @project.id), class: "#{'is-active' if @authoring_mode == 'generate'}", aria: {current: @authoring_mode == "generate" ? "page" : nil}, data: {turbo_frame: "modal"} %>
        <%= link_to "Write", new_document_path(project_id: @project.id, mode: "write"), class: "#{'is-active' if @authoring_mode == 'write'}", aria: {current: @authoring_mode == "write" ? "page" : nil}, data: {turbo_frame: "modal"} %>
      </nav>
      <% if @authoring_mode == "write" %>
        <%= render "form", artifact: @artifact %>
      <% else %>
        <%= form_with url: generate_documents_path(project_id: @project.id), method: :post, class: "document-artifact-form" do |form| %>
          <% if @generation_error %><div class="document-artifact-errors" role="alert"><%= @generation_error %></div><% end %>
          <div class="document-artifact-field">
            <%= form.label :use_case_id, "Use case" %>
            <%= form.collection_select :use_case_id, @available_use_cases, :id, :name, include_blank: "Project", selected: params[:use_case_id] %>
          </div>
          <div class="document-artifact-field">
            <%= form.label :feature, "Feature" %>
            <%= form.text_area :feature, value: params[:feature], rows: 4, maxlength: 4000 %>
          </div>
          <div class="document-artifact-actions">
            <%= form.submit "Generate", class: "ticket-action", data: {turbo_submits_with: "Generating…"} %>
          </div>
        <% end %>
      <% end %>
    </section>
  </div>
<% end %>
