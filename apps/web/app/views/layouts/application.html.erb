<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Web" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Web">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="alternate icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag "board_interactions", defer: true %>
    <%= javascript_include_tag "top_nav_autofold", defer: true %>
    <%= javascript_include_tag "protocol_document_editor", defer: true %>
  </head>

  <body>
    <% if authenticated? %>
      <header class="top-nav" data-nav-state="expanded">
        <nav aria-label="Primary navigation">
          <%= link_to boards_path, class: "top-nav-logo-link", aria: { label: "Home" } do %>
            <%= image_tag "/logo.png",
                          alt: "RedWright",
                          class: "top-nav-logo",
                          width: 77,
                          height: 77,
                          style: "display:block;max-width:77px;max-height:77px;object-fit:contain;" %>
          <% end %>
          <div class="top-nav-links">
            <%= link_to "Boards", boards_path, class: "top-nav-link" %>
            <% if navigation_project %>
              <%= link_to "Protocols", project_protocols_path(navigation_project), class: "top-nav-link" %>
            <% end %>
            <%= link_to "Docs", documents_path, class: "top-nav-link" %>
            <% if current_user&.admin? %>
              <%= link_to "Settings", protocol_templates_path, class: "top-nav-link" %>
            <% end %>
          </div>
        </nav>
        <button type="button" class="top-nav-pin" aria-label="Pin menu" aria-pressed="false" title="Pin menu">📌</button>
        <button type="button" class="top-nav-handle" aria-label="Toggle menu" aria-expanded="true"></button>
      </header>
    <% end %>
    <%= yield %>
  </body>
</html>
