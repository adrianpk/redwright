<main class="document-artifacts-show">
  <header class="document-artifacts-header">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Quizzes", project_quizzes_path(@project) %>
    </p>
    <div class="quiz-header-row">
      <h1><%= @quiz.use_case&.name || "Project Quiz" %></h1>
      <div class="quiz-mode-switch" aria-label="Quiz mode">
        <% Quiz::MODES.each do |mode| %>
          <%= button_to mode.capitalize,
                        mode_project_quiz_path(@project, @quiz),
                        method: :patch,
                        params: { mode: mode },
                        class: "quiz-mode-action#{' is-active' if @quiz.mode == mode}",
                        disabled: @quiz.mode == mode %>
        <% end %>
      </div>
    </div>
  </header>

  <section class="document-artifact-panel quiz-turn-surface" data-quiz-processing-surface>
    <div class="quiz-question-block">
      <div id="quiz-processing-feedback"
           class="quiz-processing-feedback"
           role="status"
           aria-live="polite"
           hidden>
        <span class="quiz-processing-dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <% if @show_fast_refill_hint %>
          <span class="quiz-processing-hint">Preparing fast loop.</span>
        <% end %>
      </div>
      <p><%= @current_question %></p>
    </div>

    <%= form_with url: answer_project_quiz_path(@project, @quiz),
                  method: :post,
                  class: "document-artifact-form",
                  id: "quiz-answer-form",
                  data: {
                    quiz_processing_form: true,
                    quiz_processing_target: "quiz-processing-feedback",
                    quiz_processing_message: "Generating next question..."
                  } do |form| %>
      <div class="document-artifact-field document-artifact-field-body-only">
        <%= form.text_area :answer, rows: 8, placeholder: "Answer..." %>
      </div>
    <% end %>

    <div class="quiz-action-row">
      <div class="quiz-action-group">
        <%= button_to "Skip",
                      skip_project_quiz_path(@project, @quiz),
                      method: :post,
                      class: "ticket-action",
                      form: {
                        data: {
                          quiz_processing_form: true,
                          quiz_processing_target: "quiz-processing-feedback",
                          quiz_processing_message: "Generating next question..."
                        }
                      } %>
        <button type="submit" form="quiz-answer-form" class="ticket-action ticket-action-primary">Answer</button>
      </div>
      <div class="quiz-action-group">
        <%= button_to "Cancel", cancel_project_quiz_path(@project, @quiz), method: :post, class: "ticket-action ticket-action-danger" %>
        <%= button_to "Done", done_project_quiz_path(@project, @quiz), method: :post, class: "ticket-action" %>
      </div>
    </div>
  </section>

  <% if @recent_entries.any? %>
    <section class="artifact-type-nav" aria-label="Recent quiz entries">
      <% @recent_entries.each do |entry| %>
        <article class="artifact-type-card">
          <h2><%= entry.status.capitalize %></h2>
          <div class="protocol-card-preview" aria-hidden="true">
            <span><%= entry.question %></span>
            <% unless entry.answer.blank? %>
              <span><%= entry.answer %></span>
            <% end %>
            <% entry.tags.map(&:name).each do |tag| %>
              <span><%= tag %></span>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
  <% end %>
</main>
