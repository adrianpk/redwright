<main class="document-artifacts-show">
  <header class="document-artifacts-header">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Quizzes", project_quizzes_path(@project) %>
    </p>
    <h1><%= @quiz.use_case&.name || "Project Quiz" %></h1>
  </header>

  <section class="document-artifact-panel">
    <div class="quiz-question-block">
      <p><%= @current_question %></p>
    </div>

    <%= form_with url: answer_project_quiz_path(@project, @quiz), method: :post, class: "document-artifact-form" do |form| %>
      <%= hidden_field_tag :question, @current_question %>
      <%= hidden_field_tag :tags, @current_tags.join(",") %>
      <div class="document-artifact-field document-artifact-field-body-only">
        <%= form.text_area :answer, rows: 8, placeholder: "Answer..." %>
      </div>
      <div class="document-artifact-actions">
        <span class="document-save-status">Controls: answer, skip, done, cancel</span>
        <%= form.submit "Answer", class: "ticket-action" %>
      </div>
    <% end %>

    <div class="quiz-control-actions">
      <%= button_to "Skip", skip_project_quiz_path(@project, @quiz), method: :post, params: { question: @current_question, tags: @current_tags.join(",") }, class: "ticket-action" %>
      <%= button_to "Done", done_project_quiz_path(@project, @quiz), method: :post, params: { question: @current_question, tags: @current_tags.join(",") }, class: "ticket-action" %>
      <%= button_to "Cancel", cancel_project_quiz_path(@project, @quiz), method: :post, params: { question: @current_question, tags: @current_tags.join(",") }, class: "ticket-action ticket-action-danger" %>
    </div>
  </section>

  <% if @recent_entries.any? %>
    <section class="artifact-type-nav" aria-label="Recent quiz entries">
      <% @recent_entries.each do |entry| %>
        <article class="artifact-type-card">
          <h2><%= entry.status.capitalize %></h2>
          <div class="protocol-card-preview" aria-hidden="true">
            <span><%= entry.question %></span>
            <% unless entry.answer.blank? %>
              <span><%= entry.answer %></span>
            <% end %>
            <% entry.tags.map(&:name).each do |tag| %>
              <span><%= tag %></span>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
  <% end %>
</main>
