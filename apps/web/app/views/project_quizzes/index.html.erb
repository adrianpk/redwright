<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row">
      <h1>Quizzes</h1>
      <% if @available_use_cases_for_quiz.any? %>
        <details class="quiz-new-use-case-menu">
          <summary class="ticket-action quiz-new-use-case-trigger">New Quiz</summary>
          <div class="quiz-new-use-case-dropdown">
            <% @available_use_cases_for_quiz.each do |use_case| %>
              <%= button_to use_case.name,
                            use_case_project_quizzes_path(@project),
                            method: :post,
                            params: { use_case_id: use_case.id },
                            class: "quiz-new-use-case-option" %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
    <p class="board-key">Project: <%= @project.name %></p>
  </section>

  <section class="artifact-type-nav" aria-label="Quiz navigation">
    <% @quizzes.each do |quiz| %>
      <%= link_to project_quiz_path(@project, quiz), class: "artifact-type-card" do %>
        <h2><%= quiz.use_case&.name || "Project Quiz" %></h2>
        <% preview_lines = quiz.entries.order(created_at: :desc).limit(6).reverse.map { |entry| "#{entry.status}: #{entry.question}" } %>
        <% preview_lines = ["No answers yet"] if preview_lines.empty? %>
        <div class="protocol-card-preview" aria-hidden="true">
          <% preview_lines.each do |line| %>
            <span><%= line %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>

</main>
