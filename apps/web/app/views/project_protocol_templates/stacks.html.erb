<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Settings", protocol_templates_path %>
    </p>
    <div class="board-title-row">
      <h1>Stack Protocol Templates</h1>
      <%= link_to "New Stack Template", new_stack_protocol_templates_path, class: "ticket-action" %>
    </div>
  </section>

  <section class="artifact-type-nav" aria-label="Stack protocol template navigation">
    <% @stack_templates.each do |template| %>
      <%= link_to protocol_template_path(template), class: "artifact-type-card" do %>
        <h2><%= template.name %></h2>
        <% preview_lines = template.documents.flat_map { |document| document.body.to_s.lines.map(&:strip).reject(&:blank?).first(3) }.first(6) %>
        <% if preview_lines.any? %>
          <div class="protocol-card-preview" aria-hidden="true">
            <% preview_lines.each do |line| %>
              <span><%= line %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>
</main>
