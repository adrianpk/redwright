<main class="document-artifacts-edit">
  <p class="document-artifact-breadcrumb">
    <%= link_to "Settings", protocol_templates_path %> /
    <%= link_to "Stack Protocol Templates", stacks_protocol_templates_path %>
  </p>
  <header class="document-artifacts-header"><h1>New Stack Protocol Template</h1></header>
  <section class="document-artifact-panel">
    <%= form_with scope: :protocol_template, url: stacks_protocol_templates_path, html: { class: "document-artifact-form" } do |form| %>
      <% if @error %><div class="document-artifact-errors"><%= @error %></div><% end %>
      <div class="document-artifact-field">
        <%= form.label :key, "Stack identity" %>
        <%= form.text_field :key, value: @stack_key, required: true %>
      </div>
      <div class="document-artifact-actions"><%= form.submit "Create", class: "ticket-action" %></div>
    <% end %>
  </section>
</main>
