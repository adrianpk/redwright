<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row">
      <h1>Settings</h1>
    </div>
  </section>

  <section class="artifact-type-nav" aria-label="Protocol template navigation">
    <%= link_to common_protocol_templates_path, class: "artifact-type-card" do %>
      <h2>Common Protocol Templates</h2>
      <p>Shared AGENTS, behavioral protocols, and Playbooks.</p>
    <% end %>
    <%= link_to stacks_protocol_templates_path, class: "artifact-type-card" do %>
      <h2>Stack Protocol Templates</h2>
      <p>One template set per stack identity, with direct stack-set management.</p>
    <% end %>
  </section>
</main>
