<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row">
      <h1>Protocol Templates</h1>
    </div>
  </section>

  <section class="template-group">
    <h2>Common Templates</h2>
    <div class="artifact-list">
      <% @common_templates.each do |template| %>
        <article class="artifact-list-card">
          <%= link_to protocol_template_path(template) do %>
            <strong><%= template.name %></strong>
            <span><%= pluralize(template.documents.size, "document") %></span>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>

  <section class="template-group">
    <h2>Stack Templates</h2>
    <div class="artifact-list">
      <% @stack_templates.each do |template| %>
        <article class="artifact-list-card">
          <%= link_to protocol_template_path(template) do %>
            <strong><%= template.name %></strong>
            <span><%= template.key %></span>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
</main>
