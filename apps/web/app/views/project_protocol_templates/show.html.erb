<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Settings", protocol_templates_path %>
      /
      <% if @template.common? %>
        <%= link_to "Common Protocol Templates", common_protocol_templates_path %>
      <% else %>
        <%= link_to "Stack Protocol Templates", stacks_protocol_templates_path %>
      <% end %>
    </p>
    <div class="board-title-row">
      <h1><%= @template.name %></h1>
    </div>
    <p class="board-key"><%= @template.template_kind %>: <%= @template.key %></p>
    <div class="artifact-context-row">
      <span class="artifact-context-chip"><%= @template.common? ? "Common" : "Stack" %></span>
      <span class="artifact-context-chip"><%= pluralize(@entries.count, "entry") %></span>
      <span class="artifact-context-chip"><%= @template.key %></span>
    </div>
  </section>

  <section class="artifact-list">
    <% @entries.each do |entry| %>
      <article class="artifact-list-card<%= ' is-missing' if entry.missing? %>">
        <% if entry.playbooks_index? %>
          <%= link_to(@template.common? ? common_playbooks_protocol_templates_path : playbooks_protocol_template_path(@template)) do %>
            <strong><%= entry.title %></strong>
            <span><%= entry.path %></span>
            <span class="artifact-card-note">Open dedicated view</span>
            <span class="artifact-context-chip artifact-context-chip-inline">Playbooks</span>
          <% end %>
        <% elsif entry.missing? %>
          <div class="artifact-list-card-body">
            <strong><%= entry.title %></strong>
            <span><%= entry.path %></span>
            <span class="artifact-status artifact-status-missing">Missing</span>
            <span class="artifact-card-note">Create this canonical template entry directly from the set.</span>
            <%= button_to "Create", documents_protocol_template_path(@template, key: entry.key), method: :post, class: "ticket-action" %>
          </div>
        <% else %>
          <%= link_to edit_protocol_template_document_path(@template, entry.document) do %>
            <strong><%= entry.title %></strong>
            <span><%= entry.path %></span>
            <span class="artifact-card-note">Open the template document editor.</span>
            <span class="artifact-context-chip artifact-context-chip-inline"><%= entry.layer.capitalize %></span>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </section>
</main>
