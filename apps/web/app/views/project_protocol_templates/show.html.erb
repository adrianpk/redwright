<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Settings", protocol_templates_path %>
      /
      <% if @template.common? %>
        <%= link_to "Common Protocol Templates", common_protocol_templates_path %>
      <% else %>
        <%= link_to "Stack Protocol Templates", stacks_protocol_templates_path %>
      <% end %>
    </p>
    <div class="board-title-row">
      <h1><%= @template.name %></h1>
    </div>
  </section>

  <section class="artifact-type-nav" aria-label="Protocol template document navigation">
    <% @entries.each do |entry| %>
      <% if entry.playbooks_index? %>
        <%= link_to(@template.common? ? common_playbooks_protocol_templates_path : playbooks_protocol_template_path(@template), class: "artifact-type-card") do %>
          <h2><%= entry.title %></h2>
          <% preview_lines = ProjectProtocols::LocalProtocolSource::PROTOCOL_FILES.map { |file| file[1] }.select { |path| path.start_with?(".agents/playbooks/") }.map { |path| File.basename(path) }.first(6) %>
          <% if preview_lines.any? %>
            <div class="protocol-card-preview" aria-hidden="true">
              <% preview_lines.each do |line| %>
                <span><%= line %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% elsif entry.missing? %>
        <div class="artifact-type-card">
          <h2><%= entry.title %></h2>
          <div class="artifact-list-card-body">
            <%= button_to "Create", documents_protocol_template_path(@template, key: entry.key), method: :post, class: "ticket-action" %>
          </div>
        </div>
      <% else %>
        <%= link_to edit_protocol_template_document_path(@template, entry.document), class: "artifact-type-card" do %>
          <h2><%= entry.title %></h2>
          <% preview_lines = entry.body.to_s.lines.map(&:strip).reject(&:blank?).first(6) %>
          <% if preview_lines.any? %>
            <div class="protocol-card-preview" aria-hidden="true">
              <% preview_lines.each do |line| %>
                <span><%= line %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</main>
