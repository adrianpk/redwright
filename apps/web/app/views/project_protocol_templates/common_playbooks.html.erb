<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <p class="document-artifact-breadcrumb">
      <%= link_to @template.name, @template.common? ? common_protocol_templates_path : protocol_template_path(@template) %>
    </p>
    <div class="board-title-row">
      <h1>Playbooks</h1>
    </div>
  </section>

  <section class="artifact-type-nav" aria-label="Common playbook template navigation">
    <% [@playbooks_index, *@playbook_entries].compact.each do |entry| %>
      <%= render "document_card", entry: entry %>
    <% end %>
  </section>
</main>
