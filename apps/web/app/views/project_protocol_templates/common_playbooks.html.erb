<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Settings", protocol_templates_path %>
      /
      <%= link_to "Common Protocol Templates", common_protocol_templates_path %>
    </p>
    <div class="board-title-row">
      <h1>Playbooks</h1>
      <% if (index = @template.files.documents.find(&:playbooks_index?)) %>
        <%= link_to "Edit PLAYBOOKS.md", edit_protocol_template_document_path(@template, index), class: "ticket-action" %>
      <% end %>
    </div>
  </section>

  <section class="artifact-type-nav" aria-label="Common playbook template navigation">
    <% @playbook_entries.each do |entry| %>
        <%= link_to edit_protocol_template_document_path(@template, entry), class: "artifact-type-card" do %>
          <h2><%= entry.title %></h2>
          <% preview_lines = entry.body.to_s.lines.map(&:strip).reject(&:blank?).first(6) %>
          <% if preview_lines.any? %>
            <div class="protocol-card-preview" aria-hidden="true">
              <% preview_lines.each do |line| %>
                <span><%= line %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
    <% end %>
  </section>
</main>
