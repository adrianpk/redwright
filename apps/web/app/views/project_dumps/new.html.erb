<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <section class="modal-card specification-editor" role="dialog" aria-modal="true" aria-labelledby="new-dump-heading">
      <header class="modal-header">
        <h1 id="new-dump-heading">New</h1>
        <button type="button" class="modal-icon-button modal-close" aria-label="Close modal">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>
      <% if @available_use_cases.empty? %>
        <%= link_to "New case", new_project_use_case_path(@project), class: "ticket-action", data: {turbo_frame: "modal"} %>
      <% else %>
      <%= form_with url: project_dumps_path(@project), method: :post do |form| %>
        <div class="document-artifact-field">
          <%= form.label :use_case_name, "Use case" %>
          <%= form.collection_select :use_case_name, @available_use_cases, :name, :name, {prompt: "Select"}, required: true %>
        </div>
        <div class="document-artifact-actions"><%= form.submit "Create", class: "ticket-action" %></div>
      <% end %>
      <% end %>
    </section>
  </div>
<% end %>
