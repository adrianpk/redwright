<main class="document-artifacts-show" data-dump-document>
  <header class="document-artifacts-header">
    <div class="quiz-header-row">
      <h1><%= @dump.title %></h1>
      <%= button_to "Curate", curate_project_dump_path(@project, @dump), method: :post,
                    params: {revision: @dump.source_hash}, class: "ticket-action", form: {data: {dump_curate: true, turbo: false}} %>
    </div>
    <dl class="artifact-context-row artifact-metadata" aria-label="Dump metadata">
      <% if @dump.use_case && @dump.use_case.name != @dump.title %>
        <div class="artifact-context-chip"><dt>Case</dt><dd><%= @dump.use_case.name %></dd></div>
      <% end %>
      <div class="artifact-context-chip" data-dump-state data-state="<%= @dump.status %>">
        <dt>Status</dt><dd data-dump-state-label><%= @dump.status.humanize %></dd>
      </div>
    </dl>
  </header>

  <% if flash[:alert] %><p class="dump-document-error" role="alert"><%= flash[:alert] %></p><% end %>
  <section class="document-artifact-panel">
    <div class="dump-document-view ticket-markdown" data-dump-view role="button" tabindex="0" aria-label="Edit dump" title="Click to edit">
      <%= artifact_markdown(@dump.body) %>
      <% if @dump.body.blank? %><p class="dump-document-placeholder">Click to write.</p><% end %>
    </div>
    <%= form_with model: @dump, url: project_dump_path(@project, @dump), method: :patch,
                  class: "document-artifact-form dump-document-editor", data: {dump_editor: true, turbo: false}, html: {hidden: true} do |form| %>
      <%= form.hidden_field :revision, value: @dump.source_hash %>
      <div class="document-artifact-field document-artifact-field-body-only">
        <%= form.text_area :body, rows: 20, aria: {label: "Dump Markdown"} %>
      </div>
      <div class="dump-document-toolbar">
        <%= form.label :status %>
        <%= form.select :status, Dump::STATUSES.map { |status| [status.humanize, status] } %>
        <button type="submit" class="ticket-action">Save</button>
      </div>
      <p class="dump-document-error" data-dump-error role="alert" hidden></p>
    <% end %>
    <p class="dump-document-feedback" data-dump-feedback role="status" aria-live="polite"></p>
  </section>
</main>
