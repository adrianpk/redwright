<main class="document-artifacts-show">
  <header class="document-artifacts-header">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Dumps", project_dumps_path(@project) %>
    </p>
    <div class="quiz-header-row">
      <h1><%= @dump.title %></h1>
      <div class="quiz-action-group">
        <% if @dump.capturing? %>
          <%= button_to "Cancel", cancel_project_dump_path(@project, @dump), method: :post, class: "ticket-action ticket-action-danger" %>
          <%= button_to "Done", done_project_dump_path(@project, @dump), method: :post, class: "ticket-action" %>
        <% else %>
          <%= button_to "Curate", curate_project_dump_path(@project, @dump), method: :post, class: "ticket-action" %>
        <% end %>
      </div>
    </div>
    <p class="board-key">
      <%= @dump.use_case&.name || "Project" %> · <%= @dump.status %> · <%= @dump.capture_status %> · <%= @dump.curation_status %>
    </p>
  </header>

  <% if @dump.capturing? %>
    <section class="document-artifact-panel">
      <%= form_with url: append_project_dump_path(@project, @dump),
                    method: :post,
                    class: "document-artifact-form",
                    id: "dump-entry-form" do |form| %>
        <div class="document-artifact-field document-artifact-field-body-only">
          <%= form.text_area :raw_input, rows: 7, placeholder: "Add a dump entry..." %>
        </div>
        <div class="document-artifact-actions">
          <button type="submit" class="ticket-action ticket-action-primary">Add Entry</button>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @entries.any? %>
    <section class="artifact-type-nav" aria-label="Dump entries">
      <% @entries.each do |entry| %>
        <article class="artifact-type-card">
          <h2>Entry <%= entry.position %></h2>
          <div class="protocol-card-preview" aria-hidden="true">
            <span><%= entry.polished_input %></span>
            <% unless entry.derived_thread_hint.blank? %>
              <span><%= entry.derived_thread_hint %></span>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
  <% end %>

  <% if @dump.raw_body.present? %>
    <section class="document-artifact-panel">
      <pre><%= @dump.raw_body %></pre>
    </section>
  <% end %>

  <% if @dump.curated_body.present? %>
    <section class="document-artifact-panel">
      <pre><%= @dump.curated_body %></pre>
    </section>
  <% end %>
</main>
