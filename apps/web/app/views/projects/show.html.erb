<main class="project-show">
  <header>
    <h1><%= @project.name %></h1>
    <p><%= @project.description %></p>
  </header>

  <section>
    <p><strong>Root path:</strong> <%= @project.root_path %></p>
    <p><strong>Repository:</strong> <%= @project.repo_url %></p>
    <p><strong>Stack:</strong> <%= @project.stack_slug %></p>
  </section>

  <section class="projects-list">
    <%= link_to project_protocols_path(@project), class: "board-list-card" do %>
      <strong>Protocols</strong>
      <span><%= pluralize(Array(@project.protocol_state["documents"]).size, "document") %></span>
    <% end %>
    <%= link_to documents_path(project_id: @project.id), class: "board-list-card" do %>
      <strong>Specs</strong>
      <span><%= pluralize(@project.documents.specifications.count, "spec") %></span>
    <% end %>
    <% if (board = @project.boards_scope.first) %>
      <%= link_to board_path(board), class: "board-list-card" do %>
        <strong>Board</strong>
        <span><%= board.name %></span>
      <% end %>
    <% end %>
  </section>
</main>
