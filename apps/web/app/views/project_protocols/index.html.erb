<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <div class="board-title-row">
      <h1 class="visually-hidden">Protocols</h1>
    </div>
    <p class="board-key">Workspace: <code><%= @catalog.root %></code></p>
  </section>

  <section class="artifact-type-nav" aria-label="Protocol navigation">
    <% if @protocol_entries.empty? %>
      <p>No protocol files found in the local project workspace.</p>
    <% end %>
    <% @protocol_entries.each do |entry| %>
      <% if entry.playbooks_index? %>
        <%= link_to playbooks_project_protocols_path(@project), class: "artifact-type-card" do %>
          <h2><%= entry.title %></h2>
          <% preview_lines = @playbook_listing_lines.first(6) %>
          <% if preview_lines.any? %>
            <div class="protocol-card-preview" aria-hidden="true">
              <% preview_lines.each do |line| %>
                <span><%= line %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <%= link_to project_protocol_path(@project, entry), class: "artifact-type-card" do %>
          <h2><%= entry.title %></h2>
          <% preview_lines = entry.body.to_s.lines.map(&:strip).reject(&:blank?).first(6) %>
          <% if preview_lines.any? %>
            <div class="protocol-card-preview" aria-hidden="true">
              <% preview_lines.each do |line| %>
              <span><%= line %></span>
            <% end %>
          </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</main>
