<main class="document-artifacts-index">
  <section class="documents-top-shell">
    <p class="document-artifact-breadcrumb">
      <%= link_to "Protocols", project_protocols_path(@project) %>
    </p>
    <div class="board-title-row">
      <h1>Playbooks</h1>
      <% if @playbooks_index %>
        <%= link_to "Edit PLAYBOOKS.md", project_protocol_path(@project, @playbooks_index), class: "ticket-action" %>
      <% end %>
    </div>
  </section>

  <section class="artifact-type-nav" aria-label="Playbook navigation">
    <% @playbook_entries.each do |entry| %>
      <%= link_to project_protocol_path(@project, entry), class: "artifact-type-card" do %>
        <h2><%= entry.title %></h2>
        <% preview_lines = entry.body.to_s.lines.map(&:strip).reject(&:blank?).first(6) %>
        <% if preview_lines.any? %>
          <div class="protocol-card-preview" aria-hidden="true">
            <% preview_lines.each do |line| %>
              <span><%= line %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>
</main>
