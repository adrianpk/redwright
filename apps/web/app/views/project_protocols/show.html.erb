<main class="document-artifacts-show">
  <p class="document-artifact-breadcrumb">
    <%= link_to "Protocols", project_protocols_path(@project) %>
  </p>
  <header class="document-artifacts-header">
    <h1><%= @protocol_document.title %></h1>
    <p class="board-key"><%= @protocol_document.path %></p>
  </header>
  <section class="document-artifact-panel">
    <%= render "form", project: @project, protocol_document: @protocol_document, submit_label: "Save" %>
  </section>

  <div class="document-artifact-inline-actions">
    <%= button_to "Delete Protocol", project_protocol_path(@project, @protocol_document), method: :delete, class: "ticket-action ticket-action-danger" %>
  </div>
</main>
