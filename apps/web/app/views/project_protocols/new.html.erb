<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <section class="modal-card specification-editor" role="dialog" aria-modal="true" aria-labelledby="new-protocol-heading">
      <header class="modal-header">
        <h1 id="new-protocol-heading">New</h1>
        <button type="button" class="modal-icon-button modal-close" aria-label="Close modal">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>
      <%= render "form", project: @project, protocol_document: @protocol_document %>
    </section>
  </div>
<% end %>
