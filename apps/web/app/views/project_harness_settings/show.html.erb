<main class="harness-settings">
  <header>
    <h1>Harness</h1>
    <p>Prepared profiles for <%= @project.name %>. Saved defaults do not change active operations.</p>
  </header>

  <% if @selection_error %>
    <div class="document-artifact-errors" role="alert"><%= @selection_error %></div>
  <% end %>

  <section class="document-artifact-panel" aria-labelledby="harness-choices-heading">
    <h2 id="harness-choices-heading">Configured selections</h2>
    <% [["authoring", "Authoring", "Codex default"], ["ticket_proposal", "Ticket proposals", "Direct API default"]].each do |role, label, default| %>
      <% field = "#{role}_profile"; selected = @snapshot.fetch("selection")[field] %>
      <%= form_with url: project_harness_setting_path(@project), method: :patch, scope: :harness_setting, class: "harness-role-form", aria: { label: label } do |form| %>
        <%= form.hidden_field :expected_revision, value: @snapshot.fetch("selection").fetch("revision"), id: "harness-#{role}-revision" %>
        <%= form.hidden_field :request_id, value: SecureRandom.uuid, id: "harness-#{role}-request" %>
        <div class="document-artifact-field">
          <%= form.label field, label, for: "harness-#{role}" %>
          <% choices = [["Use #{default}", ""]] + @snapshot.fetch("profiles").map { |profile| ["#{profile.fetch('name')} · #{profile.fetch('harness').capitalize}#{' · unavailable' unless profile['ready']}", profile.fetch('name')] } %>
          <% choices << ["#{selected} · unavailable", selected] if selected && choices.none? { |_, key| key == selected } %>
          <%= form.select field, options_for_select(choices, selected || ""), {}, id: "harness-#{role}" %>
        </div>
        <%= form.submit "Save", class: "ticket-action", aria: { label: "Save #{label.downcase}" } %>
      <% end %>
    <% end %>
    <p class="harness-note">With no profile selected, authoring uses Codex and ticket proposals use the existing direct API configuration.</p>
  </section>

  <section class="document-artifact-panel" aria-labelledby="harness-readiness-heading">
    <h2 id="harness-readiness-heading">Local readiness</h2>
    <p class="harness-note">These checks do not contact providers. Authentication is checked when a call runs.</p>
    <% if @snapshot["profiles_error"] %>
      <p role="alert"><%= @snapshot["profiles_error"] %></p>
    <% elsif @snapshot.fetch("profiles").empty? %>
      <p>No prepared profiles are configured. Existing defaults remain available.</p>
    <% end %>
    <ul class="harness-profile-list">
      <% @snapshot.fetch("profiles").each do |profile| %>
        <li>
          <strong><%= profile.fetch("name") %></strong>
          <span><%= profile.fetch("harness").capitalize %> · <%= profile["requested_provider"].presence || "Unknown provider" %> / <%= profile["requested_model"].presence || "Unknown model" %></span>
          <span class="harness-note"><%= profile.fetch("readiness") %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="document-artifact-panel" aria-labelledby="harness-active-heading" data-harness-active>
    <h2 id="harness-active-heading">Active bindings</h2>
    <% if @snapshot.fetch("active_bindings").empty? %>
      <p>No active harness operations.</p>
    <% end %>
    <ul class="harness-profile-list">
      <% @snapshot.fetch("active_bindings").each do |operation| %>
        <% binding = operation.fetch("binding") %>
        <li>
          <strong><%= operation.fetch("purpose").humanize %> · <%= operation.fetch("state").humanize %></strong>
          <span><%= binding["profile"].presence || "#{binding.fetch('harness').humanize} default" %></span>
          <span class="harness-note">Requested provider/model: <%= binding["requested_provider"].presence || "Unknown" %> / <%= binding["requested_model"].presence || "Unknown" %></span>
        </li>
      <% end %>
    </ul>
  </section>
</main>
